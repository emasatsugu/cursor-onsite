# apps/control-plane
PORT=3001
DATABASE_PATH=./data/poc.sqlite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEMO_USER_ID=demo-user
# Set MOCK_OPENAI=1 to use a canned stream (no API key needed)
MOCK_OPENAI=1
# Evict VMs from the in-memory pool if no register/heartbeat within this window
VM_HEARTBEAT_TIMEOUT_MS=30000
# Reclaim sticky assignment after last browser subscriber leaves (ms).
# 0 = on demand (recommended). Raise (e.g. 3000) to tolerate brief WS reconnects.
IDLE_RECLAIM_MS=0
